include CONTRIBUTING.md DESIGN.md LICENSE README.md SECURITY.md THIRD_PARTY_NOTICES.md CHANGELOG.md requirements.txt
recursive-include LICENSES *.txt
recursive-include pdfscan/data *.json
recursive-include pdfscan/web *.html *.css *.js *.svg *.woff2 *.txt
